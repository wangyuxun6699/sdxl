# DashScope 的 OpenAI 兼容接口，用于意图识别和 SDXL 提示词整理。
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL="qwen3.7-plus"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# SDXL 单文件基础模型，以及与该基础模型兼容的分区 LoRA。
SDXL_BASE_MODEL_PATH="D:\models\sdxl\base.safetensors"
SDXL_RESIDENTIAL_LORA_MODEL="D:\models\sdxl\residential.safetensors"
SDXL_INDUSTRIAL_LORA_MODEL="D:\models\sdxl\industrial.safetensors"
SDXL_COMMERCIAL_LORA_MODEL="D:\models\sdxl\commercial.safetensors"
SDXL_PUBLIC_LORA_MODEL="D:\models\sdxl\public.safetensors"

# 可按 LoRA 训练情况调整融合强度。
SDXL_RESIDENTIAL_LORA_STRENGTH="0.9"
SDXL_INDUSTRIAL_LORA_STRENGTH="0.9"
SDXL_COMMERCIAL_LORA_STRENGTH="0.9"
SDXL_PUBLIC_LORA_STRENGTH="0.9"

# from_single_file 仍需要 SDXL 的 Diffusers 配置文件；正式部署建议显式指定本地目录。
SDXL_DIFFUSERS_CONFIG_PATH="D:\models\sdxl\diffusers-config"
SDXL_CONFIG_REPO="stabilityai/stable-diffusion-xl-base-1.0"
HF_HUB_CACHE="D:\models\huggingface-cache"

# 仅用于联调：设为 1 后跳过 DashScope 和 SDXL，改走规则路由与 mock 图片。
# CITY_PLANNER_TEST_MODE="1"
